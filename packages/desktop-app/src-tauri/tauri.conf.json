{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astram",
  "version": "0.1.0",
  "identifier": "com.astram.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @astram/ui run build",
    "beforeBuildCommand": "pnpm --filter @astram/ui run build",
    "frontendDist": "../../dashboard-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Astram Command Center",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "tooltip": "Astram Zero-Trust Security Microkernel",
      "title": "Astram"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}

