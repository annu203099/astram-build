# astram environment configuration (copy to .env — never commit real keys)

# Fast Decision API (any OpenAI-compatible endpoint: Groq / DeepSeek / OpenRouter / Jev).
# OPTIONAL: without a key astram fails closed to the deterministic AST verdict.
JEV_API_KEY=
JEV_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
JEV_MODEL_ID=llama-3.3-70b-versatile

# astram daemon port (default 3080)
AEGIS_PORT=3080

# Override astram home directory (default %USERPROFILE%\.astram)
# ASTRAM_HOME=C:\Users\you\.astram
